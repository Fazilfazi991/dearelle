{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "account.html", "use": "@vercel/static" },
    { "src": "product.html", "use": "@vercel/static" },
    { "src": "category.html", "use": "@vercel/static" },
    { "src": "cart.html", "use": "@vercel/static" },
    { "src": "checkout.html", "use": "@vercel/static" },
    { "src": "send-gift-to-india.html", "use": "@vercel/static" },
    { "src": "gift-box-builder.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" },
    { "src": "admin.js", "use": "@vercel/static" },
    { "src": "account.js", "use": "@vercel/static" },
    { "src": "page.html", "use": "@vercel/static" },
    { "src": "pages.js", "use": "@vercel/static" },
    { "src": "auth.js", "use": "@vercel/static" },
    { "src": "products.js", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/index.html", "status": 308, "headers": { "Location": "/" } },
    { "src": "/admin.html", "status": 308, "headers": { "Location": "/admin" } },
    { "src": "/account.html", "status": 308, "headers": { "Location": "/account" } },
    { "src": "/product.html", "status": 308, "headers": { "Location": "/product" } },
    { "src": "/category.html", "status": 308, "headers": { "Location": "/category" } },
    { "src": "/cart.html", "status": 308, "headers": { "Location": "/cart" } },
    { "src": "/checkout.html", "status": 308, "headers": { "Location": "/checkout" } },
    { "src": "/send-gift-to-india.html", "status": 308, "headers": { "Location": "/send-gift-to-india" } },
    { "src": "/gift-box-builder.html", "status": 308, "headers": { "Location": "/send-gift-to-india" } },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/account", "dest": "/account.html" },
    { "src": "/product", "dest": "/product.html" },
    { "src": "/category", "dest": "/category.html" },
    { "src": "/earrings", "dest": "/category.html" },
    { "src": "/cart", "dest": "/cart.html" },
    { "src": "/checkout", "dest": "/checkout.html" },
    { "src": "/send-gift-to-india", "dest": "/send-gift-to-india.html" },
    { "src": "/gift-boxes/(sweet-heart-box|luxe-love-box|ultimate-surprise-box)", "dest": "/gift-box-builder.html" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/script.js", "dest": "/script.js" },
    { "src": "/admin.js", "dest": "/admin.js" },
    { "src": "/account.js", "dest": "/account.js" },
    { "src": "/pages.js", "dest": "/pages.js" },
    { "src": "/auth.js", "dest": "/auth.js" },
    { "src": "/products.js", "dest": "/products.js" },
    { "src": "/(about-us|our-craft|sustainability|care-guide|faqs|contact-us|shipping-delivery|returns-exchanges|size-guide|track-your-order|gift-cards|privacy-policy|terms-and-conditions|accessibility)", "dest": "/page.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
